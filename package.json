{
  "name": "val-metrics-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VALORANT High-Performance Stats & Desktop Overlay Application",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "dev:ui": "npm run dev --prefix frontend",
    "build:ui": "npm run build --prefix frontend",
    "dev:backend": "go run ./backend/cmd/server/main.go",
    "build:backend": "go build -o ./bin/val-metrics-server.exe ./backend/cmd/server/main.go",
    "dev:desktop": "go run ./desktop",
    "build:desktop": "go build -o ./bin/val-metrics-desktop.exe ./desktop"
  }
}
